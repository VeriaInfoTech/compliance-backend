# Copy to .env and adjust for your environment
# cp .env.example .env

# Database (used by app and mariadb service)
MYSQL_DB_HOST=mariadb
MYSQL_PORT=3306
MYSQL_DB_NAME=shahr_db
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=change-me
# MariaDB port on host (for external clients; app uses mariadb:3306)
MARIADB_HOST_PORT=3308

# phpMyAdmin
PMA_PORT=8095

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Web
HTTP_PORT=8085
BASE_URL=http://localhost:8085
